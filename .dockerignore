# Source control and developer tooling
/.git
/.github
/.idea
/.vscode
/.DS_Store
/Thumbs.db
/*.iml
/.phpunit.cache
/.php-cs-fixer.cache
/.php-cs-fixer.dist.php
/.editorconfig
/.gitattributes
/.gitignore
/AGENTS.md
/phpunit.xml
/phpstan.neon
/phpstan-bootstrap.php
/tests

# Local and private project files
/internal
/Assets
/HTML
/landing
/dev-router.php
/docker-compose.override.yml
/PlaybackReportingBackup-*.tsv
/composer.phar

# Installed dependencies are rebuilt in the image
/vendor
/node_modules

# Keep the public example, but exclude every private environment variant
/.env*
!/.env.example

# Runtime data is created by the image or supplied through volumes
/cache/*
!/cache/.gitkeep
!/cache/.htaccess
/var/cache/*
!/var/cache/.gitkeep
/var/data/*
/var/log/*
!/var/log/.gitkeep
/var/sessions/*
!/var/sessions/.gitkeep
/sqlite-data
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.htaccess
!/public/uploads/images/
/public/uploads/images/*
!/public/uploads/images/.gitkeep

# Modules are deployment-specific read-only mounts; keep the empty scaffold
/modules/*
!/modules/.gitkeep
