{% extends "_shell.twig" %}

{% block dashboard_header %}
    <div class="header-copy">
        <h1>Now Playing</h1>
        <p><span class="live-dot {{ streams|length > 0 ? 'is-live' : 'is-idle' }}" data-live-dot></span><span data-live-label>{{ is_loading|default(false) ? 'Loading sessions...' : (streams|length > 0 ? streams|length ~ ' ' ~ (streams|length == 1 ? 'stream' : 'streams') ~ ' - ' ~ stats.active_users ~ ' ' ~ (stats.active_users == 1 ? 'user' : 'users') : 'No active sessions') }}</span><span class="now-playing-collection-status" data-collection-status role="status" aria-live="polite" hidden></span></p>
    </div>
    <dl class="now-playing-telemetry" data-now-playing-telemetry aria-label="Playback telemetry">
        <div class="now-playing-metric">
            <dt><i class="dot-purple"></i>Today</dt>
            <dd data-stat="watch_today">{{ stats.watch_today }}</dd>
        </div>
        <div class="now-playing-metric">
            <dt><i class="dot-blue"></i>Bandwidth</dt>
            <dd data-stat-block="bandwidth">
                {% if stats.active_streams > 0 %}
                    <span>{{ stats.bandwidth_mbps }}</span><small>Mbps</small>
                {% else %}
                    <span class="stat-placeholder">Idle</span>
                {% endif %}
            </dd>
        </div>
        <div class="now-playing-metric">
            <dt><i class="dot-amber"></i>Transcoding</dt>
            <dd data-stat-block="transcoding">
                {% if stats.active_streams > 0 %}
                    <span>{{ stats.transcodes }}</span><small>/ {{ stats.active_streams }}</small>
                {% else %}
                    <span class="stat-placeholder">None</span>
                {% endif %}
            </dd>
        </div>
    </dl>
{% endblock %}

{% block dashboard_content %}
    <div class="now-playing-page" data-now-playing-page>
        <div class="now-playing-live{{ streams is not empty ? ' has-streams' : '' }}" data-now-playing-root>
            {% if is_loading|default(false) %}
                {% include "now_playing/_loading.twig" %}
            {% elseif streams is empty %}
                {% include "now_playing/_empty.twig" %}
            {% else %}
                <div class="stream-grid">
                    {% for stream in streams %}
                        {% include "now_playing/_stream_card.twig" with { stream: stream } %}
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        {% if show_recently_added %}
            <section class="recently-added-panel" data-recently-added aria-labelledby="recently-added-title" hidden>
                <header class="recently-added-header">
                    <span class="recently-added-mark" aria-hidden="true">
                        <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false">
                            <path d="M16 2a1 1 0 0 1 .993 .883l.007 .117v1h1a3 3 0 0 1 2.995 2.824l.005 .176v12a3 3 0 0 1 -2.824 2.995l-.176 .005h-12a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-12a3 3 0 0 1 2.824 -2.995l.176 -.005h1v-1a1 1 0 0 1 1.993 -.117l.007 .117v1h6v-1a1 1 0 0 1 1 -1m3 8h-14v8.625c0 .705 .386 1.286 .883 1.366l.117 .009h12c.513 0 .936 -.53 .993 -1.215l.007 -.16zm-9 4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1z"></path>
                        </svg>
                    </span>
                    <div>
                        <h2 id="recently-added-title">Recently Added</h2>
                        <p><span class="recently-added-source">Fresh from Jellyfin</span><span class="recently-added-count" data-recently-added-count></span></p>
                    </div>
                    <span class="recently-added-window" data-recently-added-window>Last 14 days</span>
                    <button class="recently-added-toggle" type="button" data-recently-added-toggle aria-expanded="true" aria-controls="recently-added-row" hidden>
                        <span data-recently-added-toggle-label>Hide</span>
                        <svg viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true"><path d="M6 9l6 6l6 -6"></path></svg>
                    </button>
                </header>
                <div class="recently-added-row" id="recently-added-row" data-recently-added-row tabindex="0" aria-label="Recently added media"></div>
            </section>
        {% endif %}
    </div>
{% endblock %}

{% block page_scripts %}
    <script src="/assets/js/now-playing.js?v={{ asset_revision }}"></script>
    {% if show_recently_added %}
        <script src="/assets/js/recently-added.js?v={{ asset_revision }}"></script>
    {% endif %}
{% endblock %}
