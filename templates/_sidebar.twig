{% set active_page = layout.page|default('now-playing') %}
{% set has_nav_count = streams is defined and not is_loading|default(false) %}

<aside class="dashboard-sidebar" id="dashboard-sidebar">
    <a class="brand" href="/now-playing" aria-label="Jellydash">
        <span class="brand-mark" aria-hidden="true">
            <img src="/assets/img/jellydash_logo.png" alt="">
        </span>
        <span>
            <strong>Jellydash</strong>
            {% if server_label %}<small>{{ server_label }}</small>{% endif %}
        </span>
    </a>

    <nav class="dashboard-nav" aria-label="Dashboard">
        <span class="nav-section">Monitor</span>

        <a class="nav-item {{ active_page == 'now-playing' ? 'is-active' : '' }}" href="/now-playing">
            <span class="nav-icon" aria-hidden="true">
                <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M6 4v16a1 1 0 0 0 1.524 .852l13 -8a1 1 0 0 0 0 -1.704l-13 -8a1 1 0 0 0 -1.524 .852z"></path>
                </svg>
            </span>
            <span>Now Playing</span>
            <span class="nav-pill {{ has_nav_count ? '' : 'is-loading' }}" data-nav-count>{{ has_nav_count ? streams|length : '' }}</span>
        </a>

        {% for item in module_nav %}
            <a class="nav-item {{ active_page == item.route ? 'is-active' : '' }}" href="/{{ item.route }}">
                <span class="nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img" focusable="false">{{ item.icon|raw }}</svg>
                </span>
                <span>{{ item.label }}</span>
            </a>
        {% endfor %}

        {% if seerr_enabled %}
        <a class="nav-item {{ active_page == 'jellyseerr' ? 'is-active' : '' }}" href="/jellyseerr">
            <span class="nav-icon" aria-hidden="true">
                <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z"></path>
                </svg>
            </span>
            <span>Jellyseerr</span>
        </a>
        {% endif %}

        <a class="nav-item {{ active_page == 'history' ? 'is-active' : '' }}" href="/history">
            <span class="nav-icon" aria-hidden="true">
                <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-5 2.66a1 1 0 0 0 -.993 .883l-.007 .117v5l.009 .131a1 1 0 0 0 .197 .477l.087 .1l3 3l.094 .082a1 1 0 0 0 1.226 0l.094 -.083l.083 -.094a1 1 0 0 0 0 -1.226l-.083 -.094l-2.707 -2.708v-4.585l-.007 -.117a1 1 0 0 0 -.993 -.883z"></path>
                </svg>
            </span>
            <span>History</span>
        </a>

        <a class="nav-item {{ active_page == 'statistics' ? 'is-active' : '' }}" href="/statistics">
            <span class="nav-icon" aria-hidden="true">
                <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M9.883 2.207a1.9 1.9 0 0 1 2.087 1.522l.025 .167l.005 .104v7a1 1 0 0 0 .883 .993l.117 .007h6.8a2 2 0 0 1 2 2a1 1 0 0 1 -.026 .226a10 10 0 1 1 -12.27 -11.933l.27 -.067l.11 -.02z"></path>
                    <path d="M14 3.5v5.5a1 1 0 0 0 1 1h5.5a1 1 0 0 0 .943 -1.332a10 10 0 0 0 -6.11 -6.111a1 1 0 0 0 -1.333 .943z"></path>
                </svg>
            </span>
            <span>Statistics</span>
        </a>

        <a class="nav-item {{ active_page == 'libraries' ? 'is-active' : '' }}" href="/libraries">
            <span class="nav-icon" aria-hidden="true">
                <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M18.333 2a3.667 3.667 0 0 1 3.667 3.667v8.666a3.667 3.667 0 0 1 -3.667 3.667h-8.666a3.667 3.667 0 0 1 -3.667 -3.667v-8.666a3.667 3.667 0 0 1 3.667 -3.667zm-4.333 10h-3a1 1 0 0 0 0 2h3a1 1 0 0 0 0 -2m3 -3h-6a1 1 0 0 0 0 2h6a1 1 0 0 0 0 -2m-1 -3h-5a1 1 0 0 0 0 2h5a1 1 0 0 0 0 -2"></path>
                    <path d="M3.517 6.391a1 1 0 0 1 .99 1.738c-.313 .178 -.506 .51 -.507 .868v10c0 .548 .452 1 1 1h10c.284 0 .405 -.088 .626 -.486a1 1 0 0 1 1.748 .972c-.546 .98 -1.28 1.514 -2.374 1.514h-10c-1.652 0 -3 -1.348 -3 -3v-10.002a3 3 0 0 1 1.517 -2.605"></path>
                </svg>
            </span>
            <span>Libraries</span>
        </a>
    </nav>

    <div class="sidebar-spacer"></div>

    {% if show_server_stats %}
        <section class="server-card" aria-label="Server status" data-server-card>
            <div class="server-card-header">
                <span>Server</span>
                <strong><span class="status-dot"></span><span data-server-status>Checking</span></strong>
            </div>
            <div class="server-meter">
                <span>CPU</span>
                <div class="meter-track"><span style="width: 0%" data-server-cpu-bar></span></div>
                <b data-server-cpu>...</b>
            </div>
            <div class="server-meter">
                <span>RAM</span>
                <div class="meter-track meter-track-blue"><span style="width: 0%" data-server-ram-bar></span></div>
                <b data-server-ram>...</b>
            </div>
        </section>
    {% endif %}

    {% if push_enabled and vapid_public_key %}
        <button class="settings-row push-row" type="button" data-push-toggle aria-pressed="false" hidden>
            <span class="settings-icon" aria-hidden="true">
                <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M14.235 19c.865 0 1.322 1.024 .745 1.668a3.992 3.992 0 0 1 -2.98 1.332a3.992 3.992 0 0 1 -2.98 -1.332c-.552 -.616 -.158 -1.579 .634 -1.661l.11 -.006h4.471z"></path>
                    <path d="M12 2c1.358 0 2.506 .903 2.875 2.141l.046 .171l.008 .043a8.013 8.013 0 0 1 4.024 6.069l.028 .287l.019 .289v2.931l.021 .136a3 3 0 0 0 1.143 1.847l.167 .117l.162 .099c.86 .487 .56 1.766 -.377 1.864l-.116 .006h-16c-1.028 0 -1.387 -1.364 -.493 -1.87a3 3 0 0 0 1.472 -2.063l.021 -.143l.001 -2.97a8 8 0 0 1 3.821 -6.454l.248 -.146l.01 -.043a3.003 3.003 0 0 1 2.562 -2.29l.182 -.017l.176 -.004z"></path>
                </svg>
            </span>
            <span>
                <strong>Notifications</strong>
                <small data-push-state>Off</small>
            </span>
        </button>
    {% endif %}

    <div class="sidebar-settings" data-update-status data-app-version="{{ app_version }}">
        <a class="settings-row" href="/settings#system-status" aria-label="System status, checking" data-system-status-nav>
            <span class="settings-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img" focusable="false"><path d="M3 12h4l2 -7l4 14l2 -7h6"></path></svg>
            </span>
            <span>
                <strong>System status</strong>
                <small class="system-status-nav-state"><i class="is-unknown" data-system-status-nav-dot aria-hidden="true"></i><span data-system-status-nav-label>Checking</span></small>
            </span>
        </a>
        <a class="settings-row {{ active_page == 'settings' ? 'is-active' : '' }}" href="/settings" aria-label="Settings">
            <span class="settings-icon" aria-hidden="true">
                <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M14.647 4.081a.724 .724 0 0 0 1.08 .448c2.439 -1.485 5.23 1.305 3.745 3.744a.724 .724 0 0 0 .447 1.08c2.775 .673 2.775 4.62 0 5.294a.724 .724 0 0 0 -.448 1.08c1.485 2.439 -1.305 5.23 -3.744 3.745a.724 .724 0 0 0 -1.08 .447c-.673 2.775 -4.62 2.775 -5.294 0a.724 .724 0 0 0 -1.08 -.448c-2.439 1.485 -5.23 -1.305 -3.745 -3.744a.724 .724 0 0 0 -.447 -1.08c-2.775 -.673 -2.775 -4.62 0 -5.294a.724 .724 0 0 0 .448 -1.08c-1.485 -2.439 1.305 -5.23 3.744 -3.745a.722 .722 0 0 0 1.08 -.447c.673 -2.775 4.62 -2.775 5.294 0zm-2.647 4.919a3 3 0 1 0 0 6a3 3 0 0 0 0 -6"></path>
                </svg>
            </span>
            <span>
                <strong>Settings</strong>
                <small>Jellydash v{{ app_version }}</small>
            </span>
        </a>
        <a class="update-status update-status-available" data-update-link href="https://github.com/themartz90/jellydash/releases" target="_blank" rel="noopener noreferrer" hidden>
            <svg class="icon-filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M20 16a1 1 0 0 1 1 1v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-2a1 1 0 0 1 2 0v2a1 1 0 0 0 1 1h12a1 1 0 0 0 1 -1v-2a1 1 0 0 1 1 -1m-8 -13a1 1 0 0 1 1 1v9.585l3.293 -3.292a1 1 0 0 1 1.414 1.414l-5 5a1 1 0 0 1 -.09 .08l.09 -.08a1 1 0 0 1 -.674 .292l-.033 .001h-.032l-.054 -.004l.086 .004a1 1 0 0 1 -.617 -.213a1 1 0 0 1 -.09 -.08l-5 -5a1 1 0 0 1 1.414 -1.414l3.293 3.292v-9.585a1 1 0 0 1 1 -1"></path>
            </svg>
            <span>Update available</span>
        </a>
        <span class="update-status update-status-current" data-update-current hidden>
            <svg class="icon-filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-1.293 5.953a1 1 0 0 0 -1.32 -.083l-.094 .083l-3.293 3.292l-1.293 -1.292l-.094 -.083a1 1 0 0 0 -1.403 1.403l.083 .094l2 2l.094 .083a1 1 0 0 0 1.226 0l.094 -.083l4 -4l.083 -.094a1 1 0 0 0 -.083 -1.32z"></path>
            </svg>
            <span>You're on the latest release</span>
        </span>
        <button class="update-status update-status-changes" type="button" data-release-changes hidden>
            <svg class="icon-filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M21.5 5.134a1 1 0 0 1 .493 .748l.007 .118v13a1 1 0 0 1 -1.5 .866a8 8 0 0 0 -7.5 -.266v-15.174a10 10 0 0 1 8.5 .708m-10.5 -.707l.001 15.174a8 8 0 0 0 -7.234 .117l-.327 .18l-.103 .044l-.049 .016l-.11 .026l-.061 .01l-.117 .006h-.042l-.11 -.012l-.077 -.014l-.108 -.032l-.126 -.056l-.095 -.056l-.089 -.067l-.06 -.056l-.073 -.082l-.064 -.089l-.022 -.036l-.032 -.06l-.044 -.103l-.016 -.049l-.026 -.11l-.01 -.061l-.004 -.049l-.002 -13.068a1 1 0 0 1 .5 -.866a10 10 0 0 1 8.5 -.707"></path>
            </svg>
            <span data-release-changes-label>See changes</span>
        </button>
    </div>

    {% if auth_enabled and layout.user %}
        <form class="logout-form" action="?auth=logout" method="post">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <button type="submit" class="settings-row logout-row">
                <span class="settings-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img" focusable="false">
                        <path d="M10 8v-2a2 2 0 0 1 2 -2h7a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-7a2 2 0 0 1 -2 -2v-2"></path>
                        <path d="M15 12h-12l3 -3"></path>
                        <path d="M6 15l-3 -3"></path>
                    </svg>
                </span>
                <span>
                    <strong>Sign out</strong>
                    <small>{{ layout.user.name|default(layout.user.username) }}</small>
                </span>
            </button>
        </form>
    {% endif %}
</aside>
