<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="content-language" content="en">
    <title>{{ layout.title ? layout.title ~ ' | Jellydash' : 'Jellydash' }}</title>

    {# Favicons + installable web-app icons #}
    <link rel="icon" type="image/x-icon" sizes="16x16" href="/favicon_16.ico">
    <link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon_32.ico">
    <link rel="icon" type="image/x-icon" sizes="48x48" href="/favicon_48.ico">
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest" crossorigin="use-credentials">
    <meta name="theme-color" content="#0a0910">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Jellydash">
    <meta name="csrf-token" content="{{ csrf_token }}">
    {% if push_enabled and vapid_public_key and push_enrollment_allowed %}
        <meta name="vapid-public-key" content="{{ vapid_public_key }}">
    {% endif %}

    <link rel="stylesheet" href="/assets/css/dashboard.css?v={{ asset_revision }}">
    {% for href in module_styles %}
        <link rel="stylesheet" href="{{ href }}">
    {% endfor %}
</head>
<body>
<div class="app-shell">
    <header class="mobile-topbar">
        <button class="nav-toggle" type="button" aria-label="Open menu" aria-controls="dashboard-sidebar" aria-expanded="false" data-nav-toggle>
            <svg viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true">
                <path d="M4 6l16 0"></path>
                <path d="M4 12l16 0"></path>
                <path d="M4 18l16 0"></path>
            </svg>
        </button>
        <a class="mobile-brand" href="/now-playing" aria-label="Jellydash">
            <span class="brand-mark" aria-hidden="true">
                <img src="/assets/img/jellydash_logo.png" alt="">
            </span>
            <strong>Jellydash</strong>
        </a>
        {% if push_enabled and vapid_public_key and push_enrollment_allowed %}
            <button class="topbar-bell" type="button" data-push-toggle aria-label="Playback notifications" aria-pressed="false" hidden>
                <svg class="bell-off" viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true">
                    <path d="M9.346 5.353c.21 -.129 .428 -.246 .654 -.353a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3m-1 3h-13a4 4 0 0 0 2 -3v-3a6.996 6.996 0 0 1 1.273 -3.707"></path>
                    <path d="M9 17v1a3 3 0 0 0 6 0v-1"></path>
                    <path d="M3 3l18 18"></path>
                </svg>
                <svg class="bell-on icon-filled" viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true">
                    <path d="M14.235 19c.865 0 1.322 1.024 .745 1.668a3.992 3.992 0 0 1 -2.98 1.332a3.992 3.992 0 0 1 -2.98 -1.332c-.552 -.616 -.158 -1.579 .634 -1.661l.11 -.006h4.471z"></path>
                    <path d="M12 2c1.358 0 2.506 .903 2.875 2.141l.046 .171l.008 .043a8.013 8.013 0 0 1 4.024 6.069l.028 .287l.019 .289v2.931l.021 .136a3 3 0 0 0 1.143 1.847l.167 .117l.162 .099c.86 .487 .56 1.766 -.377 1.864l-.116 .006h-16c-1.028 0 -1.387 -1.364 -.493 -1.87a3 3 0 0 0 1.472 -2.063l.021 -.143l.001 -2.97a8 8 0 0 1 3.821 -6.454l.248 -.146l.01 -.043a3.003 3.003 0 0 1 2.562 -2.29l.182 -.017l.176 -.004z"></path>
                    <circle class="bell-dot" cx="18" cy="6" r="3.2"></circle>
                </svg>
            </button>
        {% endif %}
    </header>

    <div class="nav-backdrop" data-nav-backdrop hidden></div>

    {% include "_sidebar.twig" %}

    <main class="dashboard-main">
        <header class="dashboard-header{{ layout.header_class|default('') ? ' ' ~ layout.header_class : '' }}">
            {% block dashboard_header %}{% endblock %}
        </header>

        <section class="dashboard-content{{ layout.content_class|default('') ? ' ' ~ layout.content_class : '' }}">
            {% block dashboard_content %}{% endblock %}
        </section>

        {% if not layout.hide_footer|default(false) %}
            <footer class="dashboard-footer">
                {% block dashboard_footer %}{% endblock %}
            </footer>
        {% endif %}
    </main>
</div>

{% include "_history_library_upgrade_dialog.twig" %}
{% include "_release_dialog.twig" %}

{% block page_scripts %}{% endblock %}
<script src="/assets/js/pwa.js?v=20260624-pwa"></script>
<script src="/assets/js/push.js?v={{ asset_revision }}"></script>
<script src="/assets/js/nav.js?v=20260620-nav"></script>
<script src="/assets/js/dashboard-scroll.js?v=20260910-scroll-restore"></script>
<script src="/assets/js/server-stats.js?v={{ asset_revision }}"></script>
<script src="/assets/js/nav-count.js?v={{ asset_revision }}"></script>
<script src="/assets/js/update-status.js?v={{ asset_revision }}"></script>
<script src="/assets/js/system-status.js?v={{ asset_revision }}"></script>
<script src="/assets/js/avatars.js?v={{ asset_revision }}"></script>
<script src="/assets/js/history-library-upgrade.js?v={{ asset_revision }}"></script>
<script src="/assets/js/release-highlights.js?v=20260822-history-upgrade"></script>
{% for src in module_scripts %}
    <script src="{{ src }}"></script>
{% endfor %}
</body>
</html>
