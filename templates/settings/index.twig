{% extends "_shell.twig" %}

{% block dashboard_header %}
    <div class="settings-page-header">
        <div class="header-copy">
            <h1>Settings</h1>
            <p>Preferences stored in the database; infrastructure stays in <code>.env</code></p>
        </div>
        <button type="submit" class="settings-save-btn settings-header-save" form="settings-form">Save settings</button>
    </div>
{% endblock %}

{% block dashboard_content %}
    <div class="settings-page">
        {% if saved %}
            <div class="settings-saved" role="status">Settings saved.</div>
        {% endif %}

        <div class="settings-layout">
            <form class="settings-form" id="settings-form" action="?req=settings" method="post" data-settings-form>
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

        <section class="settings-card">
            <header class="settings-card-head">
                <span class="settings-card-mark" aria-hidden="true">
                    <svg class="icon-filled" viewBox="0 0 24 24" focusable="false"><path d="M14.647 4.081a.724 .724 0 0 0 1.08 .448c2.439 -1.485 5.23 1.305 3.745 3.744a.724 .724 0 0 0 .447 1.08c2.775 .673 2.775 4.62 0 5.294a.724 .724 0 0 0 -.448 1.08c1.485 2.439 -1.305 5.23 -3.744 3.745a.724 .724 0 0 0 -1.08 .447c-.673 2.775 -4.62 2.775 -5.294 0a.724 .724 0 0 0 -1.08 -.448c-2.439 1.485 -5.23 -1.305 -3.745 -3.744a.724 .724 0 0 0 -.447 -1.08c-2.775 -.673 -2.775 -4.62 0 -5.294a.724 .724 0 0 0 .448 -1.08c-1.485 -2.439 1.305 -5.23 3.744 -3.745a.722 .722 0 0 0 1.08 -.447c.673 -2.775 4.62 -2.775 5.294 0zm-2.647 4.919a3 3 0 1 0 0 6a3 3 0 0 0 0 -6"></path></svg>
                </span>
                <span class="settings-card-copy">
                    <strong>General</strong>
                    <span>Branding and dashboard display</span>
                </span>
            </header>
            <label class="settings-field">
                <span>Server label</span>
                <input type="text" name="server_label" maxlength="64" value="{{ server_label_value }}" placeholder="e.g. media.example.com">
                <small>Shown under the Jellydash brand. Leave empty to hide.</small>
            </label>
            <div class="settings-toggle-grid">
                <div class="settings-toggle-option">
                    <label class="settings-check settings-check-toggle">
                        <input type="checkbox" name="show_server_stats" value="1" {{ show_server_stats ? 'checked' : '' }}>
                        <span>Show server statistics</span>
                    </label>
                    <small class="settings-note">Displays CPU and RAM usage in the sidebar.</small>
                </div>
                <div class="settings-toggle-option">
                    <label class="settings-check settings-check-toggle">
                        <input type="checkbox" name="show_recently_added" value="1" {{ show_recently_added ? 'checked' : '' }}>
                        <span>Show recently added media</span>
                    </label>
                    <small class="settings-note">Displays new movies and shows on the Now Playing page.</small>
                </div>
            </div>
        </section>

        <section class="settings-card">
            <header class="settings-card-head">
                <span class="settings-card-mark" aria-hidden="true">
                    <svg class="icon-filled" viewBox="0 0 24 24" focusable="false"><path d="M12 2a10 10 0 1 1 -7.071 2.929a10 10 0 0 1 7.071 -2.929zm0 2a8 8 0 0 0 -5.657 13.657l11.314 -11.314a7.963 7.963 0 0 0 -5.657 -2.343zm7.071 3.757l-11.314 11.314a8 8 0 0 0 11.314 -11.314z"></path></svg>
                </span>
                <span class="settings-card-copy">
                    <strong>Exclusions</strong>
                    <span>Choose which users and libraries to exclude from activity views and alerts.</span>
                </span>
            </header>
            <fieldset class="settings-exclusion-group">
                <legend>Monitoring</legend>
            <p class="settings-note">Excluded users are hidden from Now Playing, History, Statistics, and history exports.</p>
            {% if users is not empty %}
                <div class="settings-checks">
                    {% for user in users %}
                        <label class="settings-check">
                            <input type="checkbox" name="monitoring_ignore[]" value="{{ user }}"
                                {{ user|lower in monitoring_ignored_users|map(u => u|lower) ? 'checked' : '' }}>
                            <span>{{ user }}</span>
                        </label>
                    {% endfor %}
                </div>
                <label class="settings-field">
                    <span>Additional excluded users (comma-separated)</span>
                    <input type="text" name="monitoring_ignore_extra" value="{{ extra_monitoring_ignored }}" placeholder="Optional">
                </label>
            {% else %}
                <label class="settings-field">
                    <span>Users to exclude (comma-separated)</span>
                    <input type="text" name="monitoring_ignore_extra" value="{{ monitoring_ignored_users|join(', ') }}" placeholder="e.g. a private profile">
                </label>
            {% endif %}
            <small class="settings-note">Existing rows stay in the database. Removing an exclusion restores that earlier activity, but activity skipped while excluded cannot be reconstructed. Names match exactly and are case-insensitive.</small>
            </fieldset>
            <fieldset class="settings-exclusion-group">
                <legend>Notifications</legend>
                <p class="settings-note">Selected users never trigger playback alerts. Their activity is still recorded unless they are also excluded from monitoring.</p>
            {% if users is not empty %}
                <div class="settings-checks">
                    {% for user in users %}
                        <label class="settings-check">
                            <input type="checkbox" name="push_ignore[]" value="{{ user }}"
                                {{ user|lower in ignored_users|map(u => u|lower) ? 'checked' : '' }}>
                            <span>{{ user }}</span>
                        </label>
                    {% endfor %}
                </div>
                <label class="settings-field">
                    <span>Additional ignored users (comma-separated)</span>
                    <input type="text" name="push_ignore_extra" value="{{ extra_ignored }}" placeholder="Optional">
                </label>
                <small class="settings-note">Users appear here once they show up in play history. Typically you exclude yourself.</small>
            {% else %}
                <label class="settings-field">
                    <span>Users to ignore (comma-separated)</span>
                    <input type="text" name="push_ignore_extra" value="{{ ignored_users|join(', ') }}" placeholder="e.g. your own username">
                </label>
            {% endif %}
            </fieldset>
            <fieldset class="settings-exclusion-group">
                <legend>Statistics</legend>
                <p class="settings-note">Selected libraries are hidden from Trending and Most Watched.</p>
            {% if libraries is not null and libraries is not empty %}
                <div class="settings-checks">
                    {% for library in libraries %}
                        <label class="settings-check">
                            <input type="checkbox" name="trending_exclude[]" value="{{ library }}"
                                {{ library|lower in excluded|map(l => l|lower) ? 'checked' : '' }}>
                            <span>{{ library }}</span>
                        </label>
                    {% endfor %}
                </div>
                <label class="settings-field">
                    <span>Additional excluded libraries (comma-separated)</span>
                    <input type="text" name="trending_exclude_extra" value="{{ extra_excluded }}" placeholder="Optional">
                    <small>For libraries Jellyfin didn't report just now.</small>
                </label>
            {% else %}
                <label class="settings-field">
                    <span>Libraries to exclude (comma-separated)</span>
                    <input type="text" name="trending_exclude_extra" value="{{ excluded|join(', ') }}" placeholder="e.g. Home Videos">
                    <small>Jellyfin didn't report its libraries. Enter names manually.</small>
                </label>
            {% endif %}
            </fieldset>
        </section>

            </form>

            <section class="settings-card system-status-card" id="system-status" data-system-status aria-labelledby="system-status-title">
                <header class="settings-card-head system-status-head">
                    <span class="settings-card-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M3 12h4l2 -7l4 14l2 -7h6"></path></svg>
                    </span>
                    <span class="settings-card-copy">
                        <strong id="system-status-title">System status</strong>
                        <span data-system-status-summary>Checking system status...</span>
                    </span>
                    <button class="settings-save-btn system-status-copy" type="button" data-system-status-copy disabled>Copy diagnostics</button>
                </header>
                <div class="system-status-components" data-system-status-components aria-live="polite">
                    <div class="system-status-row is-checking">
                        <span class="system-status-state">Checking</span>
                        <span><strong>Loading checks</strong><small>Please wait.</small></span>
                    </div>
                </div>
                <p class="system-status-feedback" data-system-status-feedback role="status" aria-live="polite"></p>
                <div class="system-status-manual" data-system-status-manual hidden>
                    <label for="system-status-diagnostics">Copy the diagnostics below manually:</label>
                    <textarea id="system-status-diagnostics" data-system-status-text readonly></textarea>
                </div>
            </section>

            <section class="settings-card settings-import" id="import-history">
        <header class="settings-card-head">
            <span class="settings-card-mark" aria-hidden="true">
                <svg class="icon-filled" viewBox="0 0 24 24" focusable="false"><path d="M12 2l.117 .007a1 1 0 0 1 .876 .876l.007 .117v4l.005 .15a2 2 0 0 0 1.838 1.844l.157 .006h4l.117 .007a1 1 0 0 1 .876 .876l.007 .117v9a3 3 0 0 1 -2.824 2.995l-.176 .005h-10a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-14a3 3 0 0 1 2.824 -2.995l.176 -.005zm0 9l-.09 .004l-.058 .007l-.118 .025l-.105 .035l-.113 .054l-.111 .071a1 1 0 0 0 -.112 .097l-2.5 2.5a1 1 0 0 0 0 1.414l.094 .083a1 1 0 0 0 1.32 -.083l.793 -.793v3.586a1 1 0 0 0 2 0v-3.585l.793 .792a1 1 0 0 0 1.414 -1.414l-2.5 -2.5l-.082 -.073l-.104 -.074l-.098 -.052l-.11 -.044l-.112 -.03l-.126 -.017z"></path><path d="M19 7h-4l-.001 -4.001z"></path></svg>
            </span>
            <span class="settings-card-copy">
                <strong>Import play history</strong>
                <span>Restore a Jellydash backup or bring your old Playback Reporting history with you. Jellydash checks the file before anything is written.</span>
            </span>
        </header>
        {% if import.error %}
            <div class="settings-error" role="alert">{{ import.error }}</div>
        {% elseif import.inserted or import.skipped %}
            <div class="settings-saved" role="status">Imported {{ import.inserted }} play{{ import.inserted == 1 ? '' : 's' }}{% if import.skipped %}, skipped {{ import.skipped }} already present{% endif %}{% if import.unresolved %}, {{ import.unresolved }} without Jellyfin runtime{% endif %}.</div>
        {% endif %}
        <div class="settings-import-sources">
            <article class="settings-import-source is-jellydash">
                <div class="settings-import-source-head">
                    <span class="settings-import-source-mark" aria-hidden="true">
                        <svg class="icon-filled" viewBox="0 0 24 24" focusable="false"><path d="M14 2a1 1 0 0 1 .707 .293l5 5a1 1 0 0 1 .293 .707v11a3 3 0 0 1 -3 3h-10a3 3 0 0 1 -3 -3v-14a3 3 0 0 1 3 -3zm-2 8a1 1 0 0 0 -1 1v3.585l-1.293 -1.292a1 1 0 0 0 -1.414 1.414l3 3a1 1 0 0 0 1.414 0l3 -3a1 1 0 0 0 -1.414 -1.414l-1.293 1.292v-3.585a1 1 0 0 0 -1 -1"></path></svg>
                    </span>
                    <span><strong>Jellydash CSV</strong><small>Restore or move History</small></span>
                    <em>Native</em>
                </div>
                <form class="settings-import-form" action="/api/history-csv.php" method="post" enctype="multipart/form-data" data-import-drop data-import-endpoint="/api/history-csv.php" data-import-source="jellydash">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="commit" value="1">
                    <label class="settings-drop" data-import-dropzone>
                        <input type="file" name="jellydash_history" accept=".csv,text/csv">
                        <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true"><path d="M12 2l.117 .007a1 1 0 0 1 .876 .876l.007 .117v4l.005 .15a2 2 0 0 0 1.838 1.844l.157 .006h4l.117 .007a1 1 0 0 1 .876 .876l.007 .117v9a3 3 0 0 1 -2.824 2.995l-.176 .005h-10a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-14a3 3 0 0 1 2.824 -2.995l.176 -.005zm0 9l-.09 .004l-.058 .007l-.118 .025l-.105 .035l-.113 .054l-.111 .071a1 1 0 0 0 -.112 .097l-2.5 2.5a1 1 0 0 0 0 1.414l.094 .083a1 1 0 0 0 1.32 -.083l.793 -.793v3.586a1 1 0 0 0 2 0v-3.585l.793 .792a1 1 0 0 0 1.414 -1.414l-2.5 -2.5l-.082 -.073l-.104 -.074l-.098 -.052l-.11 -.044l-.112 -.03l-.126 -.017z"></path><path d="M19 7h-4l-.001 -4.001z"></path></svg>
                        <strong>Choose History CSV</strong>
                        <span>or drop it here</span>
                    </label>
                </form>
            </article>

            <article class="settings-import-source is-playback-reporting">
                <div class="settings-import-source-head">
                    <span class="settings-import-source-mark" aria-hidden="true">
                        <svg class="icon-filled" viewBox="0 0 24 24" focusable="false"><path d="M11 4a1 1 0 0 1 2 0v5h5a1 1 0 0 1 0 2h-5v5a1 1 0 0 1 -2 0v-5h-5a1 1 0 0 1 0 -2h5z"></path><path d="M5 2h14a3 3 0 0 1 3 3v14a3 3 0 0 1 -3 3h-14a3 3 0 0 1 -3 -3v-14a3 3 0 0 1 3 -3m0 2a1 1 0 0 0 -1 1v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1 -1v-14a1 1 0 0 0 -1 -1z"></path></svg>
                    </span>
                    <span><strong>Playback Reporting</strong><small>Bring older Jellyfin or Emby history</small></span>
                </div>
                <form class="settings-import-form" action="/api/playback-reporting.php" method="post" enctype="multipart/form-data" data-import-drop data-import-endpoint="/api/playback-reporting.php" data-import-source="playback-reporting">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="commit" value="1">
                    <label class="settings-drop" data-import-dropzone>
                        <input type="file" name="playback_reporting" accept=".tsv,.txt,.db,.sqlite,.sqlite3,text/tab-separated-values,text/plain">
                        <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true"><path d="M12 2l.117 .007a1 1 0 0 1 .876 .876l.007 .117v4l.005 .15a2 2 0 0 0 1.838 1.844l.157 .006h4l.117 .007a1 1 0 0 1 .876 .876l.007 .117v9a3 3 0 0 1 -2.824 2.995l-.176 .005h-10a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-14a3 3 0 0 1 2.824 -2.995l.176 -.005zm0 9l-.09 .004l-.058 .007l-.118 .025l-.105 .035l-.113 .054l-.111 .071a1 1 0 0 0 -.112 .097l-2.5 2.5a1 1 0 0 0 0 1.414l.094 .083a1 1 0 0 0 1.32 -.083l.793 -.793v3.586a1 1 0 0 0 2 0v-3.585l.793 .792a1 1 0 0 0 1.414 -1.414l-2.5 -2.5l-.082 -.073l-.104 -.074l-.098 -.052l-.11 -.044l-.112 -.03l-.126 -.017z"></path><path d="M19 7h-4l-.001 -4.001z"></path></svg>
                        <strong>Choose plugin backup</strong>
                        <span>TSV or SQLite database</span>
                    </label>
                    <div class="settings-import-alt" data-import-alt hidden>
                        <span class="settings-import-or">or</span>
                        <button type="submit" name="import_source" value="plugin" class="settings-secondary-btn" data-import-plugin>Import from server plugin</button>
                    </div>
                </form>
            </article>
        </div>
        <small class="settings-note" data-import-plugin-broken-note hidden>Playback Reporting v17 crashes on Jellyfin 10.11.9+. Catalog v18 is still unpublished (<a href="https://github.com/jellyfin/jellyfin-plugin-playbackreporting/pull/131" target="_blank" rel="noopener noreferrer">PR #131</a>). Drop a TSV backup instead.</small>
        <small class="settings-note" data-import-plugin-ok-note>Re-importing skips plays already in Jellydash. Imported plays never trigger notifications. Uploads must be 20 MB or smaller.</small>
            </section>
        </div>

        <div class="settings-dirty-bar" data-settings-dirty-bar hidden>
            <span aria-live="polite"><i aria-hidden="true"></i>Unsaved changes</span>
            <button type="submit" class="settings-save-btn" form="settings-form">Save changes</button>
        </div>
    </div>
{% endblock %}

{% block page_scripts %}
    {% include "_import_history_dialog.twig" %}
    <script src="/assets/js/settings-dirty.js?v=20260818"></script>
    <script src="/assets/js/history-import.js?v=20260908-stream-completion"></script>
{% endblock %}
