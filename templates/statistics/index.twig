{% extends "_shell.twig" %}

{% block dashboard_header %}
    <div class="header-copy">
        <h1>Statistics</h1>
        <p>{{ stats.subLabel }}</p>
    </div>
    <div class="header-actions statistics-header-actions">
        <div class="statistics-range-picker">
            <div class="statistics-range-meta">
                <span class="statistics-range-label">
                    <svg class="icon-filled" viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true">
                        <path d="M16 2a1 1 0 0 1 .993 .883l.007 .117v1h1a3 3 0 0 1 2.995 2.824l.005 .176v12a3 3 0 0 1 -2.824 2.995l-.176 .005h-12a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-12a3 3 0 0 1 2.824 -2.995l.176 -.005h1v-1a1 1 0 0 1 1.993 -.117l.007 .117v1h6v-1a1 1 0 0 1 1 -1m3 8h-14v8.625c0 .705 .386 1.286 .883 1.366l.117 .009h12c.513 0 .936 -.53 .993 -1.215l.007 -.16zm-9 4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1z"></path>
                    </svg>
                    Viewing period
                </span>
                {% if stats.range == default_range %}
                    <span class="statistics-default-state">
                        <svg viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true"><path d="M5 12l5 5l10 -10"></path></svg>
                        Default view
                    </span>
                {% else %}
                    <form action="?req=statistics-default" method="post">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="range" value="{{ stats.range }}">
                        <button class="statistics-default-action" type="submit" aria-label="Use {{ stats.rangeLabel }} as the default Statistics view">
                            <svg viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true"><path d="M12 17v5"></path><path d="M9 10.5v-6.5a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v6.5l3 3.5h-12z"></path></svg>
                            Make default
                        </button>
                    </form>
                {% endif %}
            </div>
            <div class="segmented-control statistics-range-control" aria-label="Statistics range">
                {% for range in stats.ranges %}
                    <a class="{{ range.active ? 'is-active' : '' }}" href="{{ range.href }}"{{ range.active ? ' aria-current="page"' : '' }}>{{ range.label }}</a>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}

{% block dashboard_content %}
    <div class="stats-page">
        <p class="stats-history-hint">
            <svg viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true">
                <path d="M3 12a9 9 0 1 0 3 -6.7l-3 2.7"></path>
                <path d="M3 3v5h5"></path>
                <path d="M12 7v5l3 2"></path>
            </svg>
            <span>Select a title, user, client or playback type to view matching plays in History.</span>
        </p>

        {% if stats.hasTrending %}
            <section class="trending-section" aria-label="Trending media">
                <header class="stats-section-header">
                    <h2>Trending</h2>
                    <span>Most-watched this period</span>
                    <i></i>
                </header>
                <div class="trending-row">
                    {% for item in stats.trending %}
                        {% include "statistics/_title_card.twig" with { item: item, rank: loop.index } only %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if stats.hasMostWatched %}
            <details class="most-watched-disclosure" data-most-watched>
                <summary class="most-watched-summary">
                    <span class="most-watched-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M8 21h8"></path>
                            <path d="M12 17v4"></path>
                            <path d="M7 4h10v5a5 5 0 0 1 -10 0z"></path>
                            <path d="M7 5h-2a2 2 0 0 0 -2 2v1a3 3 0 0 0 3 3h1"></path>
                            <path d="M17 5h2a2 2 0 0 1 2 2v1a3 3 0 0 1 -3 3h-1"></path>
                        </svg>
                    </span>
                    <span class="most-watched-copy">
                        <strong>Most Watched</strong>
                        <small>All-time favourites</small>
                    </span>
                    <span class="most-watched-context" aria-hidden="true">
                        {% if stats.mostWatched.series is not empty %}<span>TV Shows</span>{% endif %}
                        {% if stats.mostWatched.movies is not empty %}<span>Movies</span>{% endif %}
                    </span>
                    <span class="most-watched-chevron" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false"><path d="M6 9l6 6l6 -6"></path></svg>
                    </span>
                </summary>
                <div class="most-watched-content">
                    {% if stats.mostWatched.series is not empty %}
                        <span class="trending-strip-label">TV Shows</span>
                        <div class="trending-row">
                            {% for item in stats.mostWatched.series %}
                                {% include "statistics/_title_card.twig" with { item: item, rank: loop.index, defer_poster: true } only %}
                            {% endfor %}
                        </div>
                    {% endif %}
                    {% if stats.mostWatched.movies is not empty %}
                        <span class="trending-strip-label">Movies</span>
                        <div class="trending-row">
                            {% for item in stats.mostWatched.movies %}
                                {% include "statistics/_title_card.twig" with { item: item, rank: loop.index, defer_poster: true } only %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </details>
        {% endif %}

        <section class="stats-kpi-grid" aria-label="Key playback metrics">
            {% for kpi in stats.kpis %}
                <article class="stats-kpi{{ kpi.href is defined ? ' has-link' : '' }}">
                    {% if kpi.href is defined %}
                        <a class="stats-kpi-link" href="{{ kpi.href }}" aria-label="{{ kpi.label == 'Transcode Rate' ? 'View transcoded plays in History' : 'View plays in History' }}">
                    {% endif %}
                    <span class="stats-kpi-label"><i style="background: {{ kpi.color }}"></i>{{ kpi.label }}</span>
                    <strong>{{ kpi.value }}</strong>
                    <small style="color: {{ kpi.deltaColor }}">{{ kpi.delta }}</small>
                    {% if kpi.href is defined %}
                        </a>
                    {% endif %}
                </article>
            {% endfor %}
        </section>

        <header class="stats-section-header">
            <h2>General</h2>
            <span>Total watch time - top users</span>
            <i></i>
        </header>

        <section class="stats-general-grid">
            <article class="stats-card stats-watch-card">
                <div class="stats-card-head">
                    <div>
                        <span class="stats-eyebrow">{{ stats.watchTimeEstimated ? 'Estimated Watch Time' : 'Total Watch Time' }}</span>
                        <strong>{{ stats.totalWatch }}</strong>
                        <small style="color: {{ stats.totalWatchDeltaColor }}">{{ stats.totalWatchDelta }}</small>
                    </div>
                    <span class="stats-mono-chip">{{ stats.trendUnit }}</span>
                </div>
                <div class="stats-trend-bars" aria-label="Watch time trend">
                    {% for bar in stats.trend %}
                        <span aria-label="{{ bar.label }}: {{ bar.value }}">
                            <span class="visually-hidden">{{ bar.label }}: {{ bar.value }}</span>
                            <i style="height: {{ bar.h }}" title="{{ bar.value }}"></i>
                            <b>{{ bar.label }}</b>
                        </span>
                    {% endfor %}
                </div>
            </article>

            <article class="stats-card">
                <div class="stats-list-head">
                    <strong>Top Users</strong>
                    <span>by watch time</span>
                </div>
                <div class="stats-user-list">
                    {% for user in stats.topUsers %}
                        {% if user.href is defined %}
                            <a class="stats-user-row stats-user-link" href="{{ user.href }}" aria-label="View plays by {{ user.user }} in History">
                        {% else %}
                            <div class="stats-user-row">
                        {% endif %}
                            {% include "_avatar.twig" with { initials: user.initials, bg: user.avatarBg, url: user.avatarUrl } only %}
                            <div>
                                <p><strong>{{ user.user }}</strong><small>{{ user.watch }}</small></p>
                                <span class="stats-track"><i style="width: {{ user.w }}; background: {{ user.color }}"></i></span>
                            </div>
                        {% if user.href is defined %}</a>{% else %}</div>{% endif %}
                    {% else %}
                        <p class="stats-empty-note">No user history in this range.</p>
                    {% endfor %}
                </div>
            </article>
        </section>

        <header class="stats-section-header">
            <h2>Transcoding</h2>
            <span>Directness - codecs - reasons</span>
            <i></i>
        </header>

        <section class="stats-transcoding-grid">
            <article class="stats-card stats-donut-card">
                <div>
                    <strong>Playback Directness</strong>
                    <span>session mix</span>
                </div>
                <div class="stats-donut-layout">
                    <div class="stats-donut" style="background: {{ stats.directnessConic }}">
                        <span><strong>{{ stats.directVal }}</strong><small>Direct</small></span>
                    </div>
                    <div class="stats-legend">
                        {% for item in stats.directnessLegend %}
                            <a class="stats-legend-row stats-drilldown-link" href="{{ item.href }}" aria-label="View {{ item.label }} sessions in History"><i style="background: {{ item.color }}"></i><span>{{ item.label }}</span><b>{{ item.pct }}</b></a>
                        {% endfor %}
                    </div>
                </div>
            </article>

            <article class="stats-card">
                <div class="stats-list-head">
                    <strong>Codec Usage</strong>
                    <span>source video · {{ stats.codecCoverage }}</span>
                </div>
                {% if stats.hasCodecData %}
                    <div class="stats-bars">
                        {% for item in stats.codecs %}
                            <div class="stats-bar-row">
                                <p><span>{{ item.name }}</span><b>{{ item.pct }}</b></p>
                                <span class="stats-track"><i style="width: {{ item.w }}; background: {{ item.color }}"></i></span>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="stats-empty-note">Codec data will appear as new playback sessions are logged.</p>
                {% endif %}
            </article>

            <article class="stats-card">
                <div class="stats-list-head">
                    <strong>Transcoding Reasons</strong>
                    <span>share of logged reasons · {{ stats.reasonCoverage }}</span>
                </div>
                {% if stats.hasReasonData %}
                    <div class="stats-bars">
                        {% for item in stats.reasons %}
                            <div class="stats-bar-row">
                                <p><span>{{ item.name }}</span><b>{{ item.pct }}</b></p>
                                <span class="stats-track"><i style="width: {{ item.w }}; background: {{ item.color }}"></i></span>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p class="stats-empty-note">Reason data will appear for newly logged transcodes.</p>
                {% endif %}
            </article>
        </section>

        <header class="stats-section-header">
            <h2>Clients</h2>
            <span>Breakdown - popularity - transcoding - usage</span>
            <i></i>
        </header>

        <section class="stats-client-grid">
            <article class="stats-card stats-donut-card">
                <div>
                    <strong>Client Breakdown</strong>
                    <span>sessions by client</span>
                </div>
                <div class="stats-donut-layout">
                    <div class="stats-donut" style="background: {{ stats.clientsConic }}">
                        <span><strong>{{ stats.totalSessionsVal }}</strong><small>Sessions</small></span>
                    </div>
                    <div class="stats-legend">
                        {% for item in stats.clientBreakdown %}
                            <a class="stats-legend-row stats-drilldown-link" href="{{ item.href }}" aria-label="View {{ item.name }} sessions in History"><i style="background: {{ item.color }}"></i><span>{{ item.name }}</span><b>{{ item.pct }}</b></a>
                        {% else %}
                            <p class="stats-empty-note">No clients in this range.</p>
                        {% endfor %}
                    </div>
                </div>
            </article>

            <article class="stats-card">
                <div class="stats-list-head">
                    <strong>Most Popular Clients</strong>
                    <span>ranked by sessions</span>
                </div>
                <div class="stats-bars">
                    {% for item in stats.clientsRanked %}
                        <a class="stats-ranked-row stats-drilldown-link" href="{{ item.href }}" aria-label="View {{ item.name }} sessions in History">
                            <b>{{ item.rank }}</b>
                            <div>
                                <p><span>{{ item.name }}</span><small>{{ item.sessions }} sessions</small></p>
                                <span class="stats-track"><i style="width: {{ item.w }}; background: {{ item.color }}"></i></span>
                            </div>
                        </a>
                    {% else %}
                        <p class="stats-empty-note">No client sessions in this range.</p>
                    {% endfor %}
                </div>
            </article>

            <article class="stats-card">
                <div class="stats-list-head has-inline-legend">
                    <div>
                        <strong>Transcoding by Client</strong>
                        <span>direct vs transcode</span>
                    </div>
                    <p><i class="dot-green"></i>Direct <i class="dot-amber"></i>Transcode</p>
                </div>
                <div class="stats-bars">
                    {% for item in stats.clientsTranscode %}
                        <div class="stats-stack-row">
                            <p><a class="stats-client-name-link" href="{{ item.href }}" aria-label="View all {{ item.name }} sessions in History">{{ item.name }}</a><b>{{ item.transcodeVal }}</b></p>
                            <span class="stats-stack-track">
                                <i style="width: {{ item.directPct }}"></i>
                                <b style="width: {{ item.transcodePctStr }}"></b>
                            </span>
                            <span class="stats-stack-filter-links">
                                <a href="{{ item.directHref }}" aria-label="View direct playback from {{ item.name }} in History">Direct {{ item.directPct }}</a>
                                <a href="{{ item.transcodeHref }}" aria-label="View transcoded playback from {{ item.name }} in History">Transcode {{ item.transcodePctStr }}</a>
                            </span>
                        </div>
                    {% else %}
                        <p class="stats-empty-note">No client sessions in this range.</p>
                    {% endfor %}
                </div>
            </article>

            <article class="stats-card">
                <div class="stats-list-head">
                    <strong>Client Usage</strong>
                    <span>watch time per client</span>
                </div>
                <div class="stats-bars">
                    {% for item in stats.clientsUsage %}
                        <a class="stats-bar-row stats-drilldown-link" href="{{ item.href }}" aria-label="View {{ item.name }} sessions in History">
                            <p><span>{{ item.name }}</span><b>{{ item.watch }}</b></p>
                            <span class="stats-track"><i style="width: {{ item.w }}; background: {{ item.color }}"></i></span>
                        </a>
                    {% else %}
                        <p class="stats-empty-note">No client usage in this range.</p>
                    {% endfor %}
                </div>
            </article>
        </section>

        <div class="stats-devices-section" data-statistics-devices data-range="{{ stats.range }}" hidden>
            {% include "statistics/_device_icons.twig" %}
            <header class="stats-section-header">
                <h2>Devices</h2>
                <span>Registered Jellyfin clients - last activity</span>
                <i></i>
                <a class="stats-devices-manage" data-device-manage href="#" target="_blank" rel="noopener noreferrer" aria-label="Manage devices in Jellyfin" hidden>
                    <span>Manage in Jellyfin</span>
                    <svg viewBox="0 0 24 24" role="img" focusable="false" aria-hidden="true">
                        <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6"></path>
                        <path d="M11 13l9 -9"></path>
                        <path d="M15 4h5v5"></path>
                    </svg>
                </a>
            </header>

            <section class="stats-card stats-devices-card" aria-label="Jellyfin device activity">
                <div class="stats-devices-summary">
                    <p><strong data-device-known>0</strong><span>Registered clients</span></p>
                    <p><strong data-device-seen>0</strong><span data-device-range-copy>Seen in this period</span></p>
                    <p><strong data-device-active>0</strong><span>Active now</span></p>
                    <small><i></i> Live playback</small>
                </div>
                <div class="stats-device-grid" data-device-list></div>
                <p class="stats-device-note" data-device-note hidden>Showing the 6 most recently active devices.</p>
            </section>
        </div>

        <header class="stats-section-header">
            <h2>Users</h2>
            <span>Watch time - plays - average per play</span>
            <i></i>
        </header>

        <section class="stats-user-table" aria-label="User statistics">
            <div class="stats-user-head">
                <span>User</span>
                <span>Watch Time</span>
                <span>Plays</span>
                <span>Avg / Play</span>
                <span>Share</span>
            </div>
            {% for user in stats.usersTable %}
                {% if user.href is defined %}
                    <a class="stats-user-table-row stats-user-table-link" href="{{ user.href }}" aria-label="View plays by {{ user.user }} in History">
                {% else %}
                    <article class="stats-user-table-row">
                {% endif %}
                    <div class="stats-user-name">
                        {% include "_avatar.twig" with { initials: user.initials, bg: user.avatarBg, url: user.avatarUrl } only %}
                        <strong>{{ user.user }}</strong>
                    </div>
                    <span class="history-mono">{{ user.watch }}</span>
                    <span class="history-mono">{{ user.plays }}</span>
                    <span class="history-mono">{{ user.avg }}</span>
                    <span class="stats-track"><i style="width: {{ user.share }}"></i><span class="visually-hidden">{{ user.share }} of total watch time</span></span>
                {% if user.href is defined %}</a>{% else %}</article>{% endif %}
            {% else %}
                <article class="stats-user-table-row is-empty">
                    <span>No user statistics in this range.</span>
                </article>
            {% endfor %}
        </section>
    </div>
{% endblock %}

{% block page_scripts %}
    <script src="/assets/js/statistics-most-watched.js?v=20260901-disclosure"></script>
    <script src="/assets/js/statistics-devices.js?v={{ asset_revision }}"></script>
{% endblock %}
