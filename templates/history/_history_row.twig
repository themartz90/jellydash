<article class="history-row">
    <div class="history-time">{{ play.time }}</div>
    <div class="history-user">
        {% include "_avatar.twig" with { initials: play.initials, bg: play.avatarBg, url: play.avatarUrl } only %}
        <strong>{{ play.user }}</strong>
    </div>
    <div class="history-item">
        <span class="history-poster" style="background-image: {{ play.poster }}"></span>
        <span>
            <strong>{{ play.title }}</strong>
            <small>{{ play.sub }}</small>
        </span>
    </div>
    <div class="history-method">{% include "_badge.twig" with { item: play } %}</div>
    <div class="history-mono">{{ play.client }}</div>
    <div class="history-mono is-muted">{{ play.device }}</div>
    <div class="history-watched">
        <strong>{{ play.watchedLabel }}{% if play.finished %}<span aria-label="Finished">&#10003;</span>{% endif %}</strong>
        <div class="mini-track"><span style="width: {{ play.completionPct }}%"></span></div>
    </div>
</article>
