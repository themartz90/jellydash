{% extends "_shell.twig" %}

{% block dashboard_header %}
    <div class="header-copy">
        <h1>History</h1>
        <p>{% if summary.shown > 0 %}Showing {{ summary.from }}-{{ summary.to }} of {{ summary.filtered_total }} plays{% else %}Showing 0 of {{ summary.filtered_total }} plays{% endif %}</p>
    </div>
    <form class="filter-bar" method="get" action="/history">
        <label class="search-control">
            <span aria-hidden="true">Search</span>
            <input type="search" name="search" value="{{ filters.search }}" placeholder="Search title or user">
        </label>
        <select name="user" aria-label="User">
            <option value="" {{ filters.user == '' ? 'selected' : '' }}>All users</option>
            {% for user in users %}
                <option value="{{ user }}" {{ filters.user == user ? 'selected' : '' }}>{{ user }}</option>
            {% endfor %}
        </select>
        <select name="library" aria-label="Library">
            <option value="" {{ filters.library == '' ? 'selected' : '' }}>All libraries</option>
            <option value="Movies" {{ filters.library == 'Movies' ? 'selected' : '' }}>Movies</option>
            <option value="TV Shows" {{ filters.library == 'TV Shows' ? 'selected' : '' }}>TV Shows</option>
            <option value="Music" {{ filters.library == 'Music' ? 'selected' : '' }}>Music</option>
            <option value="Videos" {{ filters.library == 'Videos' ? 'selected' : '' }}>Videos</option>
        </select>
        <select name="range" aria-label="Range">
            <option value="7" {{ filters.range == '7' ? 'selected' : '' }}>Last 7 days</option>
            <option value="30" {{ filters.range == '30' ? 'selected' : '' }}>Last 30 days</option>
            <option value="all" {{ filters.range == 'all' ? 'selected' : '' }}>All time</option>
        </select>
        <button type="submit" class="filter-submit">Apply</button>
    </form>
{% endblock %}

{% block dashboard_content %}
    {% if groups is empty %}
        {% include "history/_empty.twig" %}
    {% else %}
        {% include "history/_pager.twig" %}
        {% for group in groups %}
            {% include "history/_day_group.twig" with { group: group } %}
        {% endfor %}
        {% include "history/_pager.twig" %}
    {% endif %}
{% endblock %}

{% block dashboard_footer %}
    <div class="stat-cell">
        <span><i class="dot-purple"></i>Plays shown</span>
        <strong>{% if summary.shown > 0 %}{{ summary.from }}-{{ summary.to }} <small>of {{ summary.filtered_total }}</small>{% else %}0 <small>of {{ summary.filtered_total }}</small>{% endif %}</strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-green"></i>Unique users</span>
        <strong>{{ summary.unique_users }}</strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-blue"></i>Watch time shown</span>
        <strong>{{ summary.watch_time }}</strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-amber"></i>Transcoded</span>
        <strong>{{ summary.transcoded_pct }}</strong>
    </div>
{% endblock %}
