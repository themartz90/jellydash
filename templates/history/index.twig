{% extends "_shell.twig" %}

{% block dashboard_header %}
    <div class="header-copy">
        <h1>History</h1>
        <p data-history-summary>{% if summary.shown > 0 %}Showing {{ summary.from }}-{{ summary.to }} of {{ summary.filtered_total }} plays{% else %}Showing 0 of {{ summary.filtered_total }} plays{% endif %}</p>
    </div>
    <form class="filter-bar" method="get" action="/history">
        <label class="search-control">
            <span aria-hidden="true">Search</span>
            <input type="search" name="search" value="{{ filters.search }}" placeholder="Search title or user">
        </label>
        <select name="user" aria-label="User">
            <option value="" {{ filters.user == '' ? 'selected' : '' }}>All users</option>
            {% for user in users %}
                <option value="{{ user }}" {{ filters.user == user ? 'selected' : '' }}>{{ user }}</option>
            {% endfor %}
        </select>
        <select name="library" aria-label="Library">
            <option value="" {{ filters.library == '' ? 'selected' : '' }}>All libraries</option>
            {% for library in libraries %}
                <option value="{{ library }}" {{ filters.library == library ? 'selected' : '' }}>{{ library }}</option>
            {% endfor %}
        </select>
        <select name="range" aria-label="Range">
            <option value="7" {{ filters.range == '7' ? 'selected' : '' }}>Last 7 days</option>
            <option value="30" {{ filters.range == '30' ? 'selected' : '' }}>Last 30 days</option>
            <option value="all" {{ filters.range == 'all' ? 'selected' : '' }}>All time</option>
        </select>
        <button type="submit" class="filter-submit">Apply</button>
    </form>
{% endblock %}

{% block dashboard_content %}
    <div class="history-import-banner" data-import-history-banner hidden>
        <strong>Importing play history</strong>
        <div class="import-progress">
            <div class="progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-import-history-progress-track>
                <span data-import-history-progress-bar style="width: 0%"></span>
            </div>
            <p class="import-progress-label" data-import-history-progress-label>Preparing…</p>
        </div>
    </div>
    <div data-history-live>
        {% if groups is empty %}
            {% include "history/_empty.twig" %}
        {% else %}
            {% include "history/_pager.twig" %}
            {% for group in groups %}
                {% include "history/_day_group.twig" with { group: group } %}
            {% endfor %}
            {% include "history/_pager.twig" %}
        {% endif %}
    </div>
{% endblock %}

{% block dashboard_footer %}
    <div class="stat-cell">
        <span><i class="dot-purple"></i>Plays shown</span>
        <strong data-history-shown>{% if summary.shown > 0 %}{{ summary.from }}-{{ summary.to }} <small>of {{ summary.filtered_total }}</small>{% else %}0 <small>of {{ summary.filtered_total }}</small>{% endif %}</strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-green"></i>Unique users</span>
        <strong>{{ summary.unique_users }}</strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-blue"></i>Watch time shown</span>
        <strong>{{ summary.watch_time }}</strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-amber"></i>Transcoded</span>
        <strong>{{ summary.transcoded_pct }}</strong>
    </div>
{% endblock %}

{% block page_scripts %}
    {% include "_import_history_dialog.twig" %}
    <script src="/assets/js/history-import.js?v=20260815-review"></script>
{% endblock %}
