{% extends "_shell.twig" %}

{% block dashboard_header %}
    <div class="header-copy">
        <div class="history-title-row">
            <h1>History</h1>
            <span class="history-title-actions">
                <a class="history-action-link" href="/settings#import-history">
                    <svg class="icon-filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M20 16a1 1 0 0 1 1 1v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-2a1 1 0 0 1 2 0v2a1 1 0 0 0 1 1h12a1 1 0 0 0 1 -1v-2a1 1 0 0 1 1 -1m-8 -13a1 1 0 0 1 1 1v9.585l3.293 -3.292a1 1 0 0 1 1.414 1.414l-5 5a1 1 0 0 1 -.09 .08l.09 -.08a1 1 0 0 1 -.674 .292l-.033 .001h-.032l-.054 -.004l.086 .004a1 1 0 0 1 -.617 -.213a1 1 0 0 1 -.09 -.08l-5 -5a1 1 0 0 1 1.414 -1.414l3.293 3.292v-9.585a1 1 0 0 1 1 -1"></path>
                    </svg>
                    <span>Import history</span>
                </a>
                {% if summary.total > 0 %}
                    <button class="history-action-link is-export" type="button" data-history-export-open>
                        <svg class="icon-filled" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M14 2a1 1 0 0 1 .707 .293l5 5a1 1 0 0 1 .293 .707v11a3 3 0 0 1 -3 3h-10a3 3 0 0 1 -3 -3v-14a3 3 0 0 1 3 -3zm-2 8a1 1 0 0 0 -1 1v3.585l-1.293 -1.292a1 1 0 0 0 -1.414 1.414l3 3a1 1 0 0 0 1.414 0l3 -3a1 1 0 0 0 -1.414 -1.414l-1.293 1.292v-3.585a1 1 0 0 0 -1 -1"></path>
                        </svg>
                        <span>Export CSV</span>
                    </button>
                {% endif %}
            </span>
        </div>
        <p data-history-summary>{% if summary.shown > 0 %}Showing {{ summary.from }}-{{ summary.to }} of {{ summary.filtered_total }} plays{% else %}Showing 0 of {{ summary.filtered_total }} plays{% endif %}</p>
        {% if filters.has_media %}
            <div class="history-media-scope">
                <span>{{ filters.media_type == 'series' ? 'Series' : 'Title' }}: <strong>{{ filters.media_title }}</strong>{% if filters.media_library != '' %}<small>{{ filters.media_library }}</small>{% endif %}</span>
                <a href="{{ filters.media_clear_url }}" aria-label="Remove exact title filter">Clear</a>
            </div>
        {% endif %}
    </div>
    <form class="filter-bar" method="get" action="/history" data-history-filter-form>
        {% if filters.is_exact %}
            <input type="hidden" name="start" value="{{ filters.start }}">
            <input type="hidden" name="end" value="{{ filters.end }}">
        {% endif %}
        {% if filters.has_media %}
            <input type="hidden" name="media_type" value="{{ filters.media_type }}">
            <input type="hidden" name="media_id" value="{{ filters.media_id }}">
            <input type="hidden" name="media_item_type" value="{{ filters.media_item_type }}">
            <input type="hidden" name="media_title" value="{{ filters.media_title }}">
            <input type="hidden" name="media_library" value="{{ filters.media_library }}">
        {% endif %}
        <label class="search-control" for="history-search">
            <span>Search</span>
            <input id="history-search" type="search" name="search" value="{{ filters.search }}" placeholder="Title or user">
        </label>
        <select name="user" aria-label="User">
            <option value="" {{ filters.user == '' ? 'selected' : '' }}>All users</option>
            {% for user in users %}
                <option value="{{ user }}" {{ filters.user == user ? 'selected' : '' }}>{{ user }}</option>
            {% endfor %}
        </select>
        <select name="library" aria-label="Library">
            <option value="" {{ filters.library == '' ? 'selected' : '' }}>All libraries</option>
            {% for library in libraries %}
                <option value="{{ library }}" {{ filters.library == library ? 'selected' : '' }}>{{ library }}</option>
            {% endfor %}
        </select>
        <select name="client" aria-label="Client">
            <option value="" {{ filters.client == '' ? 'selected' : '' }}>All clients</option>
            {% for client in clients %}
                <option value="{{ client }}" {{ filters.client == client ? 'selected' : '' }}>{{ client }}</option>
            {% endfor %}
        </select>
        <select name="method" aria-label="Playback method">
            <option value="" {{ filters.method == '' ? 'selected' : '' }}>All methods</option>
            <option value="direct" {{ filters.method == 'direct' ? 'selected' : '' }}>Direct (no transcode)</option>
            <option value="direct-play" {{ filters.method == 'direct-play' ? 'selected' : '' }}>Direct Play</option>
            <option value="direct-stream" {{ filters.method == 'direct-stream' ? 'selected' : '' }}>Direct Stream</option>
            <option value="transcode" {{ filters.method == 'transcode' ? 'selected' : '' }}>Transcode</option>
        </select>
        <select name="range" aria-label="Range">
            {% if filters.is_exact %}<option value="custom" selected>{{ filters.period_label }}</option>{% endif %}
            <option value="7" {{ not filters.is_exact and filters.range == '7' ? 'selected' : '' }}>Last 7 days</option>
            <option value="30" {{ not filters.is_exact and filters.range == '30' ? 'selected' : '' }}>Last 30 days</option>
            <option value="all" {{ not filters.is_exact and filters.range == 'all' ? 'selected' : '' }}>All time</option>
        </select>
        <button type="submit" class="filter-submit">Apply</button>
    </form>
{% endblock %}

{% block dashboard_content %}
    {% if groups is empty %}
        {% include "history/_empty.twig" %}
    {% else %}
        {% include "history/_pager.twig" %}
        {% for group in groups %}
            {% include "history/_day_group.twig" with { group: group } %}
        {% endfor %}
        {% include "history/_pager.twig" %}
    {% endif %}

    {% if summary.total > 0 %}
        {% include "history/_export_dialog.twig" %}
    {% endif %}
{% endblock %}

{% block dashboard_footer %}
    <div class="stat-cell">
        <span><i class="dot-purple"></i>Plays shown</span>
        <strong data-history-shown>{% if summary.shown > 0 %}{{ summary.from }}-{{ summary.to }} <small>of {{ summary.filtered_total }}</small>{% else %}0 <small>of {{ summary.filtered_total }}</small>{% endif %}</strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-green"></i>Unique users</span>
        <strong>{{ summary.unique_users }}</strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-blue"></i>{{ summary.watch_time_estimated ? 'Estimated watch time' : 'Watch time' }}</span>
        <strong>{{ summary.watch_time }}</strong>
    </div>
    <div class="stat-cell">
        <span><i class="dot-amber"></i>Transcoded</span>
        <strong>{{ summary.transcoded_pct }}</strong>
    </div>
{% endblock %}

{% block page_scripts %}
    <script src="/assets/js/history-filters.js?v=20260910-statistics-drilldowns"></script>
    {% if summary.total > 0 %}
        <script src="/assets/js/history-export.js?v={{ asset_revision }}"></script>
    {% endif %}
{% endblock %}
