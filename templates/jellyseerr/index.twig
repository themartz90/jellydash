{% extends "_shell.twig" %}
{% set layout = layout|merge({header_class: 'dashboard-header-now-playing'}) %}

{% block page_styles %}
    <link rel="stylesheet" href="/assets/css/recap.css?v={{ asset_revision }}">
    {% if configured %}<link rel="stylesheet" href="/assets/css/downloads.css?v={{ asset_revision }}-compact-widget-1">{% endif %}
    <link rel="stylesheet" href="/assets/css/seerr-requests.css?v={{ asset_revision }}-jellyfin-link-only">
{% endblock %}

{% block dashboard_header %}
    <div class="header-copy">
        <h1>Seerr</h1>
        <p>Media requests{% if configured %} <span data-seerr-stat-scope hidden><span aria-hidden="true">·</span> <span id="seerr-stat-scope">On this page</span></span>{% endif %}</p>
    </div>
    {% if configured %}
        {% embed "_header_metrics.twig" with {two_metrics: true} %}
            {% block metrics_attributes %}data-seerr-stats aria-labelledby="seerr-stat-scope" hidden{% endblock %}
            {% block metrics %}
                <div class="now-playing-metric">
                    <dt><i class="dot-green" aria-hidden="true"></i>Available</dt>
                    <dd><span data-seerr-available></span><small data-seerr-partial hidden></small></dd>
                </div>
                <div class="now-playing-metric">
                    <dt><i class="dot-blue" aria-hidden="true"></i>Requested</dt>
                    <dd data-seerr-requested></dd>
                </div>
            {% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}

{% block dashboard_content %}
    {% if configured %}
        <div class="seerr-workspace" data-seerr-workspace data-queue-url="{{ queue_url }}" data-seerr-filter="{{ filter }}">
            <div class="seerr-toolbar">
                <nav class="statistics-view-nav seerr-views" aria-label="Request views">
                    {% for key, view in views %}
                        <a href="{{ view.url }}"{% if filter == key %} aria-current="page"{% endif %}>
                            {{ view.label }} <span class="seerr-view-count" data-seerr-count="{{ key }}" hidden></span>
                        </a>
                    {% endfor %}
                </nav>
                <p class="seerr-range" data-seerr-range hidden></p>
            </div>
            <p class="seerr-announcement" data-seerr-announcement role="status" aria-atomic="true"></p>
            <section data-seerr-queue aria-label="Requests" aria-busy="true">
                <p class="seerr-loading" data-seerr-loading>Loading requests…</p>
                <noscript><p>Enable JavaScript to browse requests.</p></noscript>
            </section>
        </div>
        <dialog class="seerr-dialog" aria-labelledby="seerr-detail-heading" data-seerr-dialog>
            <div class="seerr-dialog-frame">
                <header>
                    <h2 id="seerr-detail-heading">Request details</h2>
                    <button class="release-dialog-close" type="button" data-seerr-close aria-label="Close request details" autofocus>
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 6l-12 12"></path><path d="M6 6l12 12"></path></svg>
                    </button>
                </header>
                <div data-seerr-detail aria-live="polite"></div>
                <p class="seerr-detail-feedback" data-seerr-detail-feedback role="status" aria-atomic="true" hidden></p>
            </div>
        </dialog>
        <div class="downloads-toast" data-seerr-action-status role="status" aria-live="polite" aria-atomic="true" hidden></div>
    {% else %}
        <div class="empty-state">
            <h2>Seerr isn't connected</h2>
            <p>Set <code>JELLYSEER_URL</code> and <code>JELLYSEER_API_TOKEN</code> to see requests here.</p>
        </div>
    {% endif %}
{% endblock %}

{% block page_scripts %}
    {% if configured %}<script src="/assets/js/seerr-requests.js?v={{ asset_revision }}-jellyfin-link-only"></script>{% endif %}
{% endblock %}
